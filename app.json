{
  "expo": {
    "name": "Redtale",
    "slug": "redtale",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-1.png",
    "scheme": "redtale",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.redtale.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Redtale uses your camera to let you show the agent a product or receipt.",
        "NSPhotoLibraryUsageDescription": "Redtale uses your photo library so you can share reference images with your shopping agent."
      }
    },
    "android": {
      "package": "com.redtale.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon-1.png",
        "backgroundColor": "#FAF6EE"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon-1.png"
    },
"plugins": [
  "expo-router",
  ["expo-splash-screen", {
    "image": "./assets/images/splash-icon-1.png",
    "imageWidth": 200,
    "resizeMode": "contain",
    "backgroundColor": "#FAF6EE",
    "dark": { "backgroundColor": "#1A1A1A" }
  }]
],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9bc1160f-0438-4fb7-a44a-71e27c2c4296"
      }
    }
  }
}
